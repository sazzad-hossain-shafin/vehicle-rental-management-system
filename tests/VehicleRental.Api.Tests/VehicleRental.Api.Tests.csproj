<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The provisioning SQL is the single source Docker Compose also runs (see Support/RuntimeRole.cs). -->
    <EmbeddedResource Include="..\..\scripts\sql\provision-runtime-role.sql" LogicalName="provision-runtime-role.sql" />
    <!-- Preview Row-Level Security policies, applied only inside disposable test databases. One file, shared with the infrastructure tests. -->
    <EmbeddedResource Include="..\VehicleRental.Infrastructure.IntegrationTests\Support\preview-rls.sql" LogicalName="preview-rls.sql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VehicleRental.Api\VehicleRental.Api.csproj" />
    <ProjectReference Include="..\..\src\VehicleRental.Infrastructure\VehicleRental.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\VehicleRental.Application\VehicleRental.Application.csproj" />
  </ItemGroup>

</Project>
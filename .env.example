# Settings for Docker Compose. Copy this file to ".env" (which Git ignores) and fill in the secrets,
# or let scripts/init-env.ps1 (Windows) / scripts/init-env.sh (Linux, macOS, Git Bash) do it with random values.
#
# NEVER commit ".env". Every secret below is deliberately left empty: Compose refuses to start until you set it.

# ---- PostgreSQL ----
POSTGRES_DB=vehiclerental
POSTGRES_USER=vehiclerental
# Required. Use letters and digits only: the value is placed inside a connection string, where ';' and '=' have meaning.
POSTGRES_PASSWORD=

# ---- API: token signing ----
# Required. At least 32 random characters, with real variety. Generate one with:
#   PowerShell: $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
#   bash:       openssl rand -base64 48
# Do not use a value from an example or reuse a key from another environment. The API refuses weak keys.
JWT_SIGNING_KEY=
JWT_ISSUER=VehicleRental.Api
JWT_AUDIENCE=VehicleRental.Clients

# ---- API: optional first admin account ----
# Created once on first start when BOTH are set (and the database is migrated). An existing account is never changed.
# The password needs at least 10 characters with an upper-case letter, a lower-case letter and a digit.
# Optional: the port of the customer website (default 8081). The API port is API_PORT (default 8080).
# WEB_PORT=8081

ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Optional ----
# Development (default) serves the OpenAPI document and interactive reference at /openapi/v1.json and /scalar/v1.
# Production hides them.
# ASPNETCORE_ENVIRONMENT=Development
# Host ports (both bind to localhost only).
# API_PORT=8080
# POSTGRES_HOST_PORT=5432


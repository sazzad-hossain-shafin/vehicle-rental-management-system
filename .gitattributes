# Normalise line endings: Git stores LF, working tree uses the platform default.
* text=auto

# Source and project files are text.
*.cs      text diff=csharp
*.csproj  text
*.slnx    text
*.md      text
*.json    text
*.yml     text
*.yaml    text

# Binary assets (screenshots, diagrams).
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.pdf     binary

# Files that run on Linux (inside containers or in bash) must keep LF endings, even when checked out on Windows.
*.sh      text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
compose.yaml text eol=lf
*.ps1     text
